                <item android:offset="1.0" android:color="#4010B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Drop shadow -->
    <path
        android:pathData="M40,41 C40,36 43,32 48,32 L68,32 C78,32 86,40 86,50 C86,59 79,66 70,68 L70,83 C70,86.5 67,89 63.5,89 C60,89 57,86.5 57,83 L57,71 L48,71 C43,71 40,67 40,63 Z"
