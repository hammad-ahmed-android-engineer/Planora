    <!-- Glowing circular base backdrop -->
    <path
        android:pathData="M60,60m-52,0a52,52 0 1,1 104,0a52,52 0 1,1 -104,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="15"
                android:startY="15"
                android:endX="105"
                android:endY="105"
                android:type="linear">
                <item android:offset="0.0" android:color="#256366F1" />
                <item android:offset="1.0" android:color="#101E1B4B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer rim stroke -->
    <path
        android:pathData="M60,60m-50,0a50,50 0 1,1 100,0a50,50 0 1,1 -100,0"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
