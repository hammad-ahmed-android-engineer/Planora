<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/app_name">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.planora"
            android:targetClass="com.example.planora.MainActivity">
            <extra android:name="EXTRA_ACTION" android:value="NEW_TASK" />
        </intent>
    </shortcut>
</shortcuts>
